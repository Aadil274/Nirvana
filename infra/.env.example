# ==========================================
# NIRVANA ENVIRONMENT CONFIGURATION
# ==========================================

# Application Environment
ENVIRONMENT=production
NODE_ENV=production
PROJECT_NAME="Nirvana Civic Climate System"

# Backend FastAPI Port & Host
API_HOST=0.0.0.0
API_PORT=8000
# NEXT_PUBLIC_API_URL can be provided with or without /api/v1 (e.g., http://localhost:8000 or http://localhost:8000/api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Allowed CORS origins for the FastAPI backend (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL + PostGIS Geospatial Database
DATABASE_URL=postgresql://nirvana_user:nirvana_secure_pass@localhost:5432/nirvana_db
POSTGRES_USER=nirvana_user
POSTGRES_PASSWORD=nirvana_secure_pass
POSTGRES_DB=nirvana_db

# Redis Cache & Task Queue
REDIS_URL=redis://localhost:6379/0

# Weather Telemetry Adapters (Open-Meteo is free with no key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
IMD_AWS_STATION_NETWORK=telangana_tsps
OPENWEATHERMAP_API_KEY=optional_mock_fallback_active

# Communication Channel Adapters (Mock adapters active by default for demos)
TWILIO_ACCOUNT_SID=optional_mock_ready
TWILIO_AUTH_TOKEN=optional_mock_ready
MSG91_AUTH_KEY=optional_mock_ready
WHATSAPP_CLOUD_API_TOKEN=optional_mock_ready
VAPID_PUBLIC_KEY=optional_mock_ready
VAPID_PRIVATE_KEY=optional_mock_ready

# Security & Encryption
JWT_SECRET_KEY=nirvana_super_secret_jwt_hmac_256_key_2026
PII_ENCRYPTION_KEY=nirvana_aes_256_gcm_phone_cipher_key
